{
  // Type-checks the v5 contract tests, including compile-time assertions
  // (type aliases, Props aliasing, RootProps coverage, negative
  // @ts-expect-error cases). Vitest executes these files but never
  // type-checks them, so this project closes that gap. Checked by
  // `npm run check:contracts` and `npm run check:compat`.
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "lib": ["dom", "esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "./*.test.ts",
    "./*.test.tsx",
    "../setupTests.ts",
    "../../stories/v5/MuiComposition.tsx",
    "../../stories/consumers/**/*.tsx",
    "../../playwright/consumer-integrations.spec.ts",
    "../../src/**/*"
  ],
  // Node types provide `process` here; src/env.d.ts is the library's
  // minimal stand-in for builds without them.
  "exclude": ["../../src/env.d.ts"]
}
