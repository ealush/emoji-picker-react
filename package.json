{
  "version": "4.22.3",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./primitives": {
      "import": {
        "types": "./dist/primitives/index.d.mts",
        "default": "./dist/esm/primitives/index.mjs"
      },
      "require": {
        "types": "./dist/primitives/index.d.ts",
        "default": "./dist/primitives/index.js"
      },
      "default": "./dist/primitives/index.js"
    },
    "./data": {
      "import": {
        "types": "./dist/data.d.mts",
        "default": "./dist/esm/data.mjs"
      },
      "require": {
        "types": "./dist/data.d.ts",
        "default": "./dist/data/index.js"
      },
      "default": "./dist/data/index.js"
    },
    "./data/emojis-*": {
      "import": {
        "types": "./dist/data/emojis-*.d.mts",
        "default": "./dist/data/emojis-*.mjs"
      },
      "require": {
        "types": "./dist/data/emojis-*.d.ts",
        "default": "./dist/data/emojis-*.js"
      },
      "default": "./dist/data/emojis-*.js"
    },
    "./dist/data/emojis-*.json": "./dist/data/emojis-*.json",
    "./dist/data/emojis-*": {
      "import": {
        "types": "./dist/data/emojis-*.d.mts",
        "default": "./dist/data/emojis-*.mjs"
      },
      "require": {
        "types": "./dist/data/emojis-*.d.ts",
        "default": "./dist/data/emojis-*.js"
      },
      "default": "./dist/data/emojis-*.js"
    },
    "./src/data/*.json": "./src/data/*.json",
    "./package.json": "./package.json"
  },
  "homepage": "https://ealush.com/emoji-picker-react",
  "files": [
    "dist",
    "src",
    "llms.txt",
    "llms-full.txt"
  ],
  "description": "React emoji picker: batteries included, or BYOD (bring your own design, design language and design library). Shared keyboard navigation, localization and virtualization across styled, unstyled and composed UIs.",
  "keywords": [
    "emoji-picker",
    "react-emoji-picker",
    "emoji",
    "emojis",
    "reactions",
    "reactions-picker",
    "emoji-reactions",
    "emoji picker",
    "react emoji picker",
    "design-system",
    "bring-your-own-styles",
    "plug-and-play",
    "unstyled",
    "headless",
    "composable",
    "tailwind",
    "shadcn",
    "accessible",
    "a11y",
    "typescript",
    "nextjs",
    "react-19",
    "skin-tones",
    "emoji-search",
    "i18n",
    "llms.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ealush/emoji-picker-react.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ealush"
    },
    {
      "type": "tidelift",
      "url": "https://tidelift.com/subscription/pkg/npm-emoji-picker-react"
    }
  ],
  "overrides": {
    "decode-uri-component": "0.2.2",
    "deep-object-diff": "1.1.9",
    "ua-parser-js": "0.7.41",
    "minimist": "1.2.8",
    "loader-utils": "2.0.4",
    "form-data": "4.0.6",
    "request": {
      "form-data": "2.5.6"
    },
    "tsconfig-paths": {
      "json5": "1.0.2"
    }
  },
  "scripts": {
    "start": "npm run storybook",
    "build": "npm run check:scripts && npm run clean && npm run build:data:src && npm run type-check && npm run build:data:dist && tsx ./scripts/build.ts && npm run docs:llms",
    "type-check": "tsc --noEmit --incremental --pretty --project tsconfig.json",
    "check:contracts": "tsc --project test/v5-contract/tsconfig.json --noEmit && tsx ./scripts/checkApiDocs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "lint": "eslint src",
    "prepare": "husky && npm run build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "build:data:src": "tsc --project ./scripts/tsconfig.build.json && node ./scripts/dist/prepare.js",
    "build:data:dist": "tsc --project tsconfig.data.json && tsx ./scripts/copyData.ts && tsx ./scripts/buildDataTwins.ts",
    "build:data": "npm run build:data:src && npm run build:data:dist",
    "storybook": "npm run build:data && storybook dev --host 0.0.0.0 -p 6006",
    "build-storybook": "storybook build",
    "docs:llms": "tsx ./scripts/generateLlmsTxt.ts",
    "check:react-floor": "tsx ./scripts/checkReactApiFloor.ts",
    "check:react16": "tsx ./scripts/react16-fixture/run.ts",
    "check:package": "tsx ./scripts/package-check/run.ts",
    "check:compat": "tsc --project ./compat/v4-usage/tsconfig.json --noEmit && tsc --project ./test/v5-contract/tsconfig.json --noEmit && tsc --project ./compat/exports-map/tsconfig.json --noEmit",
    "check:perf": "tsx ./bench/run.ts",
    "clean": "tsx ./scripts/clean.ts",
    "recipes": "tsx ./scripts/generateRecipes.mts",
    "designs": "tsx ./scripts/portDesigns.mts",
    "registry": "tsx ./scripts/generateRegistry.mts",
    "check:scripts": "tsc --project scripts/tsconfig.json",
    "icons": "tsx ./scripts/buildIcons.ts",
    "check:data-package": "tsx ./scripts/checkDataPackage.ts"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true
  },
  "name": "emoji-picker-react",
  "author": "ealush",
  "module": "dist/esm/index.mjs",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "75 KB"
    },
    {
      "path": "dist/esm/index.mjs",
      "limit": "75 KB"
    },
    {
      "path": "dist/esm/primitives/index.mjs",
      "limit": "75 KB"
    },
    {
      "path": "dist/esm/data.mjs",
      "limit": "42 KB"
    }
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@mui/material": "^9.4.0",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "emoji-datasource": "^16.0.0",
    "emojibase-data": "^17.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.64.0",
    "rollup-plugin-dts": "^6.5.1",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.1.0",
    "storybook": "^10.6.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.4.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "tsx": "^4.23.15",
    "@types/jsdom": "^21.1.7",
    "terser": "5.31.0"
  },
  "dependencies": {
    "shipstyles": "1.0.0"
  },
  "directories": {
    "doc": "docs",
    "example": "example",
    "test": "test"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ealush/emoji-picker-react/issues"
  }
}
